// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "wsl_connections": [
    {
      "distro_name": "FedoraLinux-44",
      "user": null,
      "projects": [
        {
          "paths": [
            "/home/bns/s2n-gallery"
          ]
        }
      ]
    }
  ],
  "git_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
  },
  "agent_ui_font_size": 14.0,
  "agent_buffer_font_size": 14.0,
  "agent_ui_font_family": "JetBrains Mono",
  "debugger": {
    "dock": "left",
  },
  "agent": {
    "sandbox_permissions": {
      "allow_all_hosts": true
    },
    "sidebar_side": "right",
    "dock": "right",
    "inline_assistant_model": {
      "provider": "vercel_ai_gateway",
      "model": "openai/gpt-5.4",
      "enable_thinking": false,
    },
    "profiles": {},
    "default_model": {
      "provider": "vercel_ai_gateway",
      "model": "openai/gpt-5.4",
      "enable_thinking": false,
    },
    "favorite_models": [
      {
        "provider": "vercel_ai_gateway",
        "model": "openai/gpt-5.4",
        "enable_thinking": false,
      },
      {
        "provider": "vercel_ai_gateway",
        "model": "anthropic/claude-opus-4.7",
        "enable_thinking": false,
      },
    ],
    "model_parameters": [],
  },
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "model": "claude-opus-5-5-high"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "mode": "agent"
      },
      "type": "registry"
    },
    "cursor": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "show_edit_predictions": false,
  "icon_theme": "Material Icon Theme",
  "vim_mode": true,
  "ui_font_size": 16,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "buffer_font_family": "MonoLisa",
  "buffer_line_height": {
    "custom": 1.4,
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "line_height": {
      "custom": 1.35,
    },
  },
  "edit_predictions": {
    "disabled_globs": ["**/**"],
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "auto_install_extensions": {
    "colored-zed-icons-theme": true,
    "git-firefly": true,
    "dockerfile": true,
    "svelte": true,
    "wakatime": true,
    "material-icon-theme": true,
    "just": true,
  },
}
