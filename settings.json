{
  "wsl_connections": [
    {
      "distro_name": "FedoraLinux-44",
      "user": null,
      "projects": [
        {
          "paths": [
            "/home/bns/s2n-gallery"
          ]
        },
        {
          "paths": [
            "/mnt/wsl/Projects/project/personal/kanflow"
          ]
        }
      ]
    }
  ],
  "git_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
  },
  "agent_ui_font_size": 14.0,
  "agent_buffer_font_size": 12.0,
  "agent_ui_font_family": "JetBrains Mono",
  "debugger": {
    "dock": "left",
  },
  "agent": {
    "expand_terminal_card": false,
    "threads_sidebar": {
      "auto_open": false,
      "position": "right",
    },
    "sandbox_permissions": {
      "allow_unsandboxed": false,
      "warn_ntfs_grants": false,
      "allow_all_hosts": true,
    },
    "dock": "right",
    "inline_assistant_model": {
      "provider": "vercel_ai_gateway",
      "model": "openai/gpt-5.4",
      "enable_thinking": false,
    },
    "profiles": {},
    "default_model": {
      "effort": "high",
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": true,
    },
    "favorite_models": [
      {
        "provider": "vercel_ai_gateway",
        "model": "openai/gpt-5.4",
        "enable_thinking": false,
      },
      {
        "provider": "vercel_ai_gateway",
        "model": "anthropic/claude-opus-4.7",
        "enable_thinking": false,
      },
    ],
    "model_parameters": [],
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "edit_file": {
          "default": "allow",
          "always_confirm": [
            {
              "pattern": "(?:^|[/\\\\])(?:\\.git|\\.ssh|\\.aws|secrets?)(?:[/\\\\]|$)|\\.(?:pem|key|p12)$|(?:^|[/\\\\])\\.env(?:\\.[^/\\\\]*)?$",
            },
          ],
        },
        "write_file": {
          "default": "allow",
          "always_confirm": [
            {
              "pattern": "(?:^|[/\\\\])(?:\\.git|\\.ssh|\\.aws|secrets?)(?:[/\\\\]|$)|\\.(?:pem|key|p12)$|(?:^|[/\\\\])\\.env(?:\\.[^/\\\\]*)?$",
            },
          ],
        },
        "create_directory": {
          "default": "allow",
        },
        "move_path": {
          "default": "allow",
          "always_confirm": [
            {
              "pattern": "(?:^|[/\\\\])(?:\\.git|\\.ssh|\\.aws|secrets?)(?:[/\\\\]|$)|\\.(?:pem|key|p12)$|(?:^|[/\\\\])\\.env(?:\\.[^/\\\\]*)?$",
            },
          ],
        },
        "copy_path": {
          "default": "allow",
          "always_confirm": [
            {
              "pattern": "(?:^|[/\\\\])(?:\\.git|\\.ssh|\\.aws|secrets?)(?:[/\\\\]|$)|\\.(?:pem|key|p12)$|(?:^|[/\\\\])\\.env(?:\\.[^/\\\\]*)?$",
            },
          ],
        },
        "delete_path": {
          "default": "allow",
          "always_deny": [
            {
              "pattern": "^(?:/|~|\\.|\\.\\.)/?$",
            },
            {
              "pattern": "^/(?:etc|usr|bin|sbin|boot|dev|proc|sys)(?:/|$)",
            },
          ],
          "always_confirm": [
            {
              "pattern": "(?:^|[/\\\\])(?:\\.git|\\.ssh|\\.aws|secrets?)(?:[/\\\\]|$)|\\.(?:pem|key|p12)$|(?:^|[/\\\\])\\.env(?:\\.[^/\\\\]*)?$",
            },
          ],
        },
        "fetch": {
          "default": "allow",
        },
        "search_web": {
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^(?:pwd|ls|tree|rg|grep|cat|head|tail|wc|which|file)(?:\\s+[^;&|<>`$\\n]+)?$",
            },
            {
              "pattern": "^git\\s+(?:status|diff|log|show|rev-parse|ls-files|blame)(?:\\s+[^;&|<>`$\\n]+)?$",
            },
            {
              "pattern": "^git\\s+branch(?:\\s+(?:-a|-r|--show-current))?$",
            },
            {
              "pattern": "^git\\s+(?:add|commit)(?:\\s+[^;&|<>`$\\n]+)?$",
            },
            {
              "pattern": "^(?:npm|pnpm|yarn|bun)\\s+(?:install|add|remove|uninstall|test|run\\s+[-\\w:.]+|build|lint|check|typecheck|format)(?:\\s+[^;&|<>`$\\n]+)?$",
            },
            {
              "pattern": "^cargo\\s+(?:check|test|build|clippy|fmt)(?:\\s+[^;&|<>`$\\n]+)?$",
            },
            {
              "pattern": "^deno\\s+(?:check|test|lint|fmt|task\\s+[-\\w:.]+)(?:\\s+[^;&|<>`$\\n]+)?$",
            },
            {
              "pattern": "^(?:mkdir|touch|cp|mv)\\s+(?:[-\\w./]+\\s*)+$",
            },
            {
              "pattern": "^rm\\s+(?:-[rf]+\\s+)?(?:\\./)?[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*/?$",
            },
            {
              "pattern": "^rm\\s+-(?:rf|fr|r)\\s+(?:\\./)?(?:\\.next|\\.cache|\\.turbo|dist|build|coverage|target|node_modules)/?$",
            },
          ],
          "always_confirm": [
            {
              "pattern": "\\b(?:sudo|doas|su|mkfs|fdisk|dd|shred)\\b",
            },
            {
              "pattern": "\\bgit\\s+(?:push|reset|clean|rebase|restore|checkout)\\b",
            },
            {
              "pattern": "\\bgit\\s+commit\\s+.*(?:--amend|--no-verify)\\b",
            },
            {
              "pattern": "\\bgit\\s+branch\\s+-[dD]\\b",
            },
            {
              "pattern": "\\b(?:npm|pnpm|yarn|bun)\\s+(?:publish|(?:install|add)\\s+.*(?:--global|-g\\b))",
            },
            {
              "pattern": "\\b(?:curl|wget)\\b[^\\n]*\\|\\s*(?:bash|sh|zsh)\\b",
            },
            {
              "pattern": "(?:^|[/\\\\])(?:\\.git|\\.ssh|\\.aws|\\.env(?:\\.[^/\\\\\\s]*)?)(?:[/\\\\\\s]|$)|\\.(?:pem|key|p12)\\b",
            },
          ],
        },
      },
    },
  },
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "mode": "yolo",
        "thinking_level": "high",
        "model": "claude-opus-5-5-high",
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "high",
        "mode": "auto",
      },
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "mode": "agent",
      },
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "CommandCode": {
      "type": "custom",
      "command": "cmd",
      "args": ["acp"],
    },
  },
  "show_edit_predictions": false,
  "icon_theme": "Material Icon Theme",
  "vim_mode": true,
  "ui_font_size": 16,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "buffer_font_family": "MonoLisa",
  "buffer_line_height": {
    "custom": 1.4,
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "line_height": {
      "custom": 1.35,
    },
  },
  "edit_predictions": {
    "disabled_globs": ["**/**"],
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "auto_install_extensions": {
    "colored-zed-icons-theme": true,
    "git-firefly": true,
    "dockerfile": true,
    "svelte": true,
    "wakatime": true,
    "material-icon-theme": true,
    "just": true,
  },
}
